# =============================================================
#  Conquest of Hearthstone - Unity .gitignore
# =============================================================

# --- Unity-generated folders (never versioned) ---------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Addressables / asset bundles (later) --------------------
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- IDE projects: regenerated by Unity on every open --------
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Builds and artifacts ------------------------------------
*.apk
*.aab
*.app
*.dmg
*.ipa
*.unitypackage
crashlytics-build.properties
sysinfo.txt

# --- Merge conflict leftovers --------------------------------
*.orig
*.tmp

# --- Operating system ----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
