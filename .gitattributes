# =============================================================
#  Conquest of Hearthstone - .gitattributes
#
#  Regle : Git LFS UNIQUEMENT pour les formats reellement
#  binaires et volumineux. Tout le contenu Unity serialise en
#  YAML (.unity, .prefab, .asset, .mat, .meta, .asmdef, ...)
#  reste en Git normal : c'est du texte, il doit rester
#  diffable et mergeable.
# =============================================================

# --- Normalisation des fins de ligne pour le texte -----------
* text=auto

*.cs        text diff=csharp
*.md        text
*.xml       text
*.yml       text
*.shader    text
*.hlsl      text
*.cginc     text
*.uxml      text
*.uss       text

# --- Formats serialises par Unity : LF force -----------------
#  Unity ecrit systematiquement ces fichiers en LF. Sans
#  eol=lf, Git les rendrait en CRLF sur Windows et Unity les
#  reecrirait en LF -> diffs parasites permanents.
*.meta                text eol=lf
*.unity               text eol=lf
*.prefab              text eol=lf
*.asset               text eol=lf
*.mat                 text eol=lf
*.anim                text eol=lf
*.controller          text eol=lf
*.overrideController  text eol=lf
*.mask                text eol=lf
*.playable            text eol=lf
*.signal              text eol=lf
*.preset              text eol=lf
*.spriteatlas         text eol=lf
*.spriteatlasv2       text eol=lf
*.renderTexture       text eol=lf
*.mixer               text eol=lf
*.terrainlayer        text eol=lf
*.physicMaterial      text eol=lf
*.physicsMaterial2D   text eol=lf
*.shadervariants      text eol=lf
*.shadergraph         text eol=lf
*.shadersubgraph      text eol=lf
*.vfx                 text eol=lf
*.lighting            text eol=lf
*.asmdef              text eol=lf
*.asmref              text eol=lf
*.json                text eol=lf
ProjectSettings/ProjectVersion.txt text eol=lf

# Fichiers de configuration du depot
.gitattributes        text eol=lf
.gitignore            text eol=lf
.vsconfig             text eol=lf

# NB : *.inputactions est volontairement absent de la liste
# ci-dessus. Le package Input System l'ecrit en CRLF sur
# Windows ; on laisse donc « text=auto » s'en charger.

# =============================================================
#  Git LFS
# =============================================================

